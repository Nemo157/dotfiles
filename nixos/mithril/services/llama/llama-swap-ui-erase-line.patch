diff --git a/src/lib/terminalLine.test.ts b/src/lib/terminalLine.test.ts
new file mode 100644
index 0000000..ace2285
--- /dev/null
+++ b/src/lib/terminalLine.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { renderTerminalLine, renderTerminalText } from "./terminalLine";
+
+describe("renderTerminalLine", () => {
+  it("leaves plain lines alone", () => {
+    expect(renderTerminalLine("hello world")).toBe("hello world");
+  });
+
+  it("overwrites on carriage return", () => {
+    expect(renderTerminalLine("load 10%\rload 20%\rload 100%")).toBe("load 100%");
+  });
+
+  it("erases to end of line", () => {
+    expect(renderTerminalLine("progress 100%\rok\x1b[K")).toBe("ok");
+    expect(renderTerminalLine("progress 100%\rok\x1b[0K")).toBe("ok");
+  });
+
+  it("erases from start of line through cursor", () => {
+    expect(renderTerminalLine("aaaaaa\rbb\x1b[1Kc")).toBe("  caaa");
+  });
+
+  it("erases the whole line without moving the cursor", () => {
+    expect(renderTerminalLine("abc\x1b[2Kx")).toBe("   x");
+  });
+
+  it("moves the cursor with C, D and G", () => {
+    expect(renderTerminalLine("abcdef\x1b[3DX")).toBe("abcXef");
+    expect(renderTerminalLine("ab\x1b[2CX")).toBe("ab  X");
+    expect(renderTerminalLine("abcdef\x1b[2GX")).toBe("aXcdef");
+  });
+
+  it("keeps colors attached to the columns they were written with", () => {
+    expect(renderTerminalLine("\x1b[32m50%\x1b[0m\r\x1b[32m100%\x1b[0m\x1b[K")).toBe(
+      "\x1b[0m\x1b[32m100%\x1b[0m",
+    );
+    expect(renderTerminalLine("\x1b[32mgreen\x1b[0m\rG")).toBe("\x1b[0mG\x1b[0m\x1b[32mreen\x1b[0m");
+    expect(renderTerminalLine("\x1b[1mab\x1b[32mcd")).toBe("\x1b[1mab\x1b[32mcd");
+  });
+
+  it("carries the current style across a carriage return", () => {
+    expect(renderTerminalLine("ab\x1b[31mcd\rx\x1b[K")).toBe("\x1b[31mx");
+  });
+
+  it("drops other CSI sequences", () => {
+    expect(renderTerminalLine("\x1b[?25lloading\x1b[?25h")).toBe("loading");
+  });
+});
+
+describe("renderTerminalText", () => {
+  it("renders each line independently and keeps CRLF clean", () => {
+    expect(renderTerminalText("a 10%\ra 100%\x1b[K\nnext\r\n")).toBe("a 100%\nnext\n");
+  });
+});
diff --git a/src/lib/terminalLine.ts b/src/lib/terminalLine.ts
