index 0000000..0ebf3a6
--- /dev/null
+++ b/src/lib/terminalLine.ts
@@ -0,0 +1,93 @@
+const CSI_REGEX = /\x1b\[([0-9;?]*)([a-zA-Z])/y;
+
+/**
+ * Replay carriage returns and cursor/erase CSI sequences within a single
+ * line the way a terminal would, so progress bars that redraw in place
+ * collapse to their final state. Supported: \r, ESC[K (erase in line,
+ * modes 0/1/2), ESC[C / ESC[D (cursor forward/back) and ESC[G (cursor to
+ * column). SGR (color) sequences are tracked per column and re-emitted so
+ * ansiToHtml can still render them; other CSI sequences are dropped.
+ */
+export function renderTerminalLine(line: string): string {
+  if (!line.includes("\r") && !line.includes("\x1b[")) return line;
+
+  // One visible character per column, plus the SGR sequences in effect
+  // (since the last reset) when it was written.
+  const chars: string[] = [];
+  const styles: string[] = [];
+  let style = "";
+  let cursor = 0;
+
+  const count = (params: string) => {
+    const n = Number.parseInt(params, 10);
+    return Number.isNaN(n) || n < 1 ? 1 : n;
+  };
+
+  for (let i = 0; i < line.length; i++) {
+    const ch = line[i];
+    if (ch === "\r") {
+      cursor = 0;
+      continue;
+    }
+    if (ch === "\x1b") {
+      CSI_REGEX.lastIndex = i;
+      const m = CSI_REGEX.exec(line);
+      if (m) {
+        const [seq, params, cmd] = m;
+        switch (cmd) {
+          case "m":
+            style = params === "" || params === "0" ? seq : style + seq;
+            break;
+          case "K":
+            if (params === "" || params === "0") {
+              chars.length = styles.length = Math.min(chars.length, cursor);
+            } else if (params === "1") {
+              for (let j = 0; j <= cursor && j < chars.length; j++) chars[j] = " ";
+            } else if (params === "2") {
+              chars.length = styles.length = 0;
+            }
+            break;
+          case "C":
+            cursor += count(params);
+            break;
+          case "D":
+            cursor = Math.max(0, cursor - count(params));
+            break;
+          case "G":
+            cursor = count(params) - 1;
+            break;
+        }
+        i += seq.length - 1;
+        continue;
+      }
+    }
+    while (chars.length < cursor) {
+      chars.push(" ");
+      styles.push(style);
+    }
+    chars[cursor] = ch;
+    styles[cursor] = style;
+    cursor++;
+  }
+
+  let out = "";
+  let prev = "";
+  const emit = (next: string) => {
+    if (next === prev) return;
+    if (next.startsWith(prev)) out += next.slice(prev.length);
+    else out += next.startsWith("\x1b[0m") || next.startsWith("\x1b[m") ? next : "\x1b[0m" + next;
+    prev = next;
+  };
+  for (let i = 0; i < chars.length; i++) {
+    emit(styles[i]);
+    out += chars[i];
+  }
+  emit(style); // leave the final state in effect for following lines
+  return out;
+}
+
+/** Apply renderTerminalLine to every line of a multi-line log. */
+export function renderTerminalText(text: string): string {
+  if (!text.includes("\r") && !text.includes("\x1b[")) return text;
+  return text.split("\n").map(renderTerminalLine).join("\n");
+}
