root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4
# one sentence per line in comments/strings; code width is left to the formatters
max_line_length = off

[*.nix]
indent_size = 2

[*.{ts,js,json}]
indent_size = 2

[*.toml]
indent_size = 2

[*.{bash,sh,zsh}]
indent_size = 2
switch_case_indent = true
# most scripts have no shebang (`writeShellApplication`), so shfmt can't detect bash
shell_variant = bash
