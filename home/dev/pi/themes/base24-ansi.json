{
	"$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
	"name": "base24-ansi",
	"vars": {
		"_comment": "Base24 palette using the ANSI column from the spec. Slots 0-15 are the standard 4-bit ANSI colors; slots 16-21 are the extended Base24 indices (base09, base0F, base01, base02, base04, base06) that the terminal / tmux is expected to remap via its Base24 theme. base10/base11 have no ANSI slot and fall back to base00.",

		"base00": 0,
		"base01": 18,
		"base02": 19,
		"base03": 8,
		"base04": 20,
		"base05": 7,
		"base06": 21,
		"base07": 15,

		"base08": 1,
